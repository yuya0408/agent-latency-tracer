        {"name": "partner_id", "type": "string", "description": "取引先ID"},
        {"name": "name", "type": "string", "description": "取引先名"},
        {"name": "kind", "type": "string", "enum": ["販売先", "仕入先", "両方"], "description": "取引の種類"},
        {"name": "payment_terms_days", "type": "integer", "description": "支払サイト(日)"}
      ]
    },
    "item": {
      "area": "共通",
      "label": "品目",
      "description": "販売・購買・在庫で扱う品目",
      "id_field": "item_code",
      "fields": [
        {"name": "item_code", "type": "string", "description": "品目コード"},
        {"name": "name", "type": "string", "description": "品目名"},
        {"name": "category", "type": "string", "description": "品目分類"},
        {"name": "unit", "type": "string", "description": "単位"},
        {"name": "standard_price", "type": "number", "description": "標準単価(円)"}
