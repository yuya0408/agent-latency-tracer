{
  "$comment": "業務ツールの定義。形は MCP の Tool そのまま(name・description・inputSchema)。引数 type の選択肢は data_schema.json の種類から loader.py が埋める。形を決めた経緯は docs/DESIGN.md §6の2b と docs/tool-catalog-survey.md。",
  "tools": [
    {
      "name": "describe_data",
      "description": "業務データの種類と項目を返す。typeを省略すると種類の一覧(区分・説明つき)、指定するとその種類の項目名・型・説明を返す。find_records等で条件や集計に使う項目名は、ここで確かめてから使う。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "description": "データの種類"}
        }
      }
    },
    {
      "name": "find_records",
      "description": "業務データから条件に合うレコードを返す。条件はすべてAND。件数が多いときは先頭のlimit件だけ返し、総件数を添える。合計・件数などの集計にはaggregate_recordsを使う。",
      "inputSchema": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "description": "データの種類"},
          "filter": {
            "type": "array",
            "description": "条件の並び。省略すると条件なし",
            "items": {
              "type": "object",
              "required": ["field", "op", "value"],
              "additionalProperties": false,
              "properties": {
                "field": {"type": "string", "description": "項目名(describe_dataで確かめる)"},
                "op": {"type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains"]},
                "value": {"type": ["string", "number", "boolean"]}
              }
            }
          },
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 100}
        }
      }
    },
    {
      "name": "get_record",
      "description": "業務データのレコードを1件、IDで返す。明細のあるデータ(受注・発注)は明細も含める。",
      "inputSchema": {
        "type": "object",
        "required": ["type", "id"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "description": "データの種類"},
          "id": {"type": "string"}
        }
      }
    },
    {
      "name": "aggregate_records",
      "description": "業務データを集計する。group_byの項目ごとに、metricの項目の合計・件数・平均を返す。条件の書き方はfind_recordsと同じ。",
      "inputSchema": {
        "type": "object",
        "required": ["type", "metric"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "description": "データの種類"},
          "metric": {
            "type": "object",
            "required": ["op"],
            "additionalProperties": false,
            "properties": {
              "op": {"type": "string", "enum": ["sum", "count", "avg"]},
              "field": {"type": "string", "description": "集計する項目。countのときは省略できる"}
            }
          },
          "group_by": {"type": "array", "items": {"type": "string"}, "description": "まとめる単位の項目。省略すると全体で1つ"},
          "filter": {
            "type": "array",
            "description": "条件の並び。省略すると条件なし",
            "items": {
              "type": "object",
              "required": ["field", "op", "value"],
              "additionalProperties": false,
              "properties": {
                "field": {"type": "string", "description": "項目名(describe_dataで確かめる)"},
                "op": {"type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains"]},
                "value": {"type": ["string", "number", "boolean"]}
              }
            }
          }
        }
      }
    }
  ]
}
